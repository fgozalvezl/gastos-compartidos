<Application x:Class="GastosCompartidos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:GastosCompartidos.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Conversores compartidos -->
            <conv:CurrencyConverter x:Key="Currency" />
            <conv:SignedCurrencyConverter x:Key="SignedCurrency" />
            <conv:BalanceToBrushConverter x:Key="BalanceBrush" />
            <conv:HexToBrushConverter x:Key="HexBrush" />
            <conv:SplitTypeConverter x:Key="SplitTypeName" />
            <conv:ThemeNameConverter x:Key="ThemeName" />
            <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisible" />
            <conv:EnumToBooleanConverter x:Key="EnumToBool" />
            <conv:CountToVisibilityConverter x:Key="CountToVisible" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVisible" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible" />
            <conv:WidthOverConverter x:Key="WidthOver" />
            <BooleanToVisibilityConverter x:Key="BoolToVisible" />

            <!--
                Colores semánticos (U5). No se definen tokens propios: WPF-UI 3.0.5 ya trae
                un valor por tema para cada uno, verificado sobre las superficies reales
                (tarjeta #FEFEFE en claro / #2B2B2B en oscuro):
                  SystemFillColorSuccessBrush   positivo   5,39:1 claro · 6,98:1 oscuro
                  SystemFillColorCriticalBrush  negativo   5,61:1 claro · 6,97:1 oscuro
                  TextFillColorSecondaryBrush   neutro     6,14:1 claro · 9,09:1 oscuro
                Usar siempre con DynamicResource para que sigan el cambio de tema.
            -->

            <!-- Estilos compartidos -->
            <Thickness x:Key="PagePadding">28,24,28,24</Thickness>

            <!-- Celdas de texto de las grillas: recortan con elipsis en vez de cortar seco (U3) -->
            <Style x:Key="GridCellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <!-- canaleta contra la columna siguiente: si no, la elipsis queda pegada al texto de al lado -->
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style x:Key="GridCellAmount" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,18" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="2,0,0,10" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="Margin" Value="0,10,0,4" />
            </Style>

            <!-- Selector de color (swatches) -->
            <DataTemplate x:Key="ColorSwatchTemplate">
                <Border Width="26" Height="26" CornerRadius="13"
                        Background="{Binding Converter={StaticResource HexBrush}}" />
            </DataTemplate>

            <!-- Selector de emoji -->
            <DataTemplate x:Key="EmojiSwatchTemplate">
                <TextBlock Text="{Binding}" FontSize="20" Width="26" Height="30"
                           TextAlignment="Center" />
            </DataTemplate>

            <Style x:Key="SwatchItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ring" CornerRadius="16" Padding="3"
                                    BorderThickness="2" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ring" Property="BorderBrush"
                                            Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ring" Property="Background"
                                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

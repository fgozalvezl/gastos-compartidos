<ui:FluentWindow x:Class="GastosCompartidos.Views.Dialogs.ExpenseEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:helpers="clr-namespace:GastosCompartidos.Helpers"
                 xmlns:conv="clr-namespace:GastosCompartidos.Converters"
                 Title="{Binding Title}"
                 Width="580" Height="760"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize" MinWidth="520" MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" helpers:ScrollViewerHelper.FixMouseWheel="True" VerticalScrollBarVisibility="Auto" Padding="22,6,22,12">
            <StackPanel>
                <!-- Fila: Fecha + Monto -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fecha" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding Date}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Monto" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox PlaceholderText="0">
                            <ui:TextBox.Text>
                                <!-- convertidor en línea (guarda el texto tecleado): sin él, al escribir
                                     la coma el binding reescribe la caja y "1500,50" termina en 150050 -->
                                <Binding Path="Amount" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.Converter>
                                        <conv:DecimalTextConverter />
                                    </Binding.Converter>
                                </Binding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Descripción" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Ej. Compra en el supermercado" />

                <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconGlyph}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding SuggestionInfo}" FontSize="11" Margin="2,4,0,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Visibility="{Binding SuggestionInfo, Converter={StaticResource NotEmptyToVisible}}" />

                <TextBlock Text="Pagó" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding PeopleSource}" SelectedItem="{Binding PaidBy}"
                          DisplayMemberPath="Name" />

                <TextBlock Text="Tipo de división" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Partes iguales" Margin="0,0,16,0"
                                 IsChecked="{Binding SplitType, Converter={StaticResource EnumToBool}, ConverterParameter=Equal}" />
                    <RadioButton Content="Proporcional al ingreso" Margin="0,0,16,0"
                                 IsChecked="{Binding SplitType, Converter={StaticResource EnumToBool}, ConverterParameter=Proportional}" />
                    <RadioButton Content="Personalizada"
                                 IsChecked="{Binding SplitType, Converter={StaticResource EnumToBool}, ConverterParameter=Custom}" />
                </StackPanel>

                <!-- Participantes -->
                <Border Margin="0,14,0,0" Padding="14" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Participantes y su parte" FontWeight="SemiBold" />
                            <TextBlock HorizontalAlignment="Right" FontSize="11" Opacity="0.6"
                                       Text="Tildá quién participa" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Participants}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="12" Height="12" CornerRadius="6" Margin="2,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding ColorHex, Converter={StaticResource HexBrush}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" />

                                        <ui:TextBox Grid.Column="3" Width="64" Margin="0,0,10,0"
                                                    ToolTip="Peso para la división personalizada"
                                                    Visibility="{Binding DataContext.IsCustom, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisible}}">
                                            <ui:TextBox.Text>
                                                <Binding Path="Weight" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.Converter>
                                                        <conv:DecimalTextConverter />
                                                    </Binding.Converter>
                                                </Binding>
                                            </ui:TextBox.Text>
                                        </ui:TextBox>

                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="90"
                                                   TextAlignment="Right"
                                                   Text="{Binding ShareAmount, Converter={StaticResource Currency}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,8" />
                        <Grid>
                            <TextBlock Text="Se reparte en total" Opacity="0.7" />
                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold"
                                       Text="{Binding PreviewTotal, Converter={StaticResource Currency}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Notas (opcional)" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" />

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisible}}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="22,14" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0" />
                <ui:Button Content="Guardar gasto" Appearance="Primary" Click="Save_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

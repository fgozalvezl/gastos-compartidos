<Page x:Class="GastosCompartidos.Views.Pages.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:GastosCompartidos.Helpers"
      Title="Categorías">

    <Grid helpers:ScrollViewerHelper.BindHeightToHost="True" Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Categorías" Style="{StaticResource PageTitle}" />
                    <!-- Indicador de carga (B14) -->
                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                     Margin="12,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
                <TextBlock Text="Las palabras clave permiten sugerir la categoría automáticamente al escribir un gasto" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                       Appearance="Primary" Content="Nueva categoría"
                       Command="{Binding AddCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- VerticalAlignment="Stretch": el estilo de ui:Card viene con Center, así que la
             tarjeta tomaba el alto natural de la lista y el ScrollViewer nunca se acotaba -->
        <ui:Card Grid.Row="1" Padding="4"
                 VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ScrollViewer helpers:ScrollViewerHelper.FixMouseWheel="True" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10"
                                            Background="{Binding ColorHex, Converter={StaticResource HexBrush}}">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="8"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="Sistema" FontSize="10" Opacity="0.75" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding KeywordsPreview}" FontSize="12" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0"
                                               FontSize="12" Opacity="0.6">
                                        <Run Text="{Binding ExpenseCount, Mode=OneWay}" />
                                        <Run Text="gastos" />
                                    </TextBlock>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Secondary" Padding="8" Margin="0,0,5,0"
                                                   ToolTip="Editar"
                                                   Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Edit24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Appearance="Danger" Padding="8"
                                                   ToolTip="Eliminar"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ui:Card>
    </Grid>
</Page>

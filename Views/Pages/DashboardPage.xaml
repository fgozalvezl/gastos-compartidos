<Page x:Class="GastosCompartidos.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:helpers="clr-namespace:GastosCompartidos.Helpers"
      Title="Dashboard">

    <ScrollViewer helpers:ScrollViewerHelper.FixMouseWheel="True"
                  helpers:ScrollViewerHelper.BindHeightToHost="True"
                  VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                        <!-- Indicador de carga (B14) -->
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                         Margin="12,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentMonthName}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                           Content="Actualizar"
                           Command="{Binding RefreshCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <!-- Aviso sin datos -->
            <ui:Card Grid.Row="1" Margin="0,0,0,16"
                     Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisible}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Todavía no cargaste gastos" FontWeight="SemiBold" />
                        <TextBlock Text="Andá a la sección «Gastos» y tocá «Nuevo gasto» para empezar. Los datos de ejemplo te muestran cómo se ve."
                                   Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--
                KPIs (U1). Los importes de 7 cifras miden 157 px a 23 px Bold y en una fila
                de 4 tarjetas sólo hay ~121 px útiles con la ventana en su ancho mínimo.
                Por debajo de 800 px de panel (≈ ventana de 1090) se apilan en 2×2, donde
                cada tarjeta tiene ~283 px. El recorte con elipsis + ToolTip queda de red.
            -->
            <UniformGrid Grid.Row="2" Margin="-6,-6,-6,10">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Rows" Value="2" />
                        <Setter Property="Columns" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding ActualWidth, RelativeSource={RelativeSource Self},
                                                   Converter={StaticResource WidthOver}, ConverterParameter=800}">
                                <Setter Property="Rows" Value="1" />
                                <Setter Property="Columns" Value="4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <ui:Card Margin="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Receipt24" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="Gastos del mes" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalExpensesMonth, Converter={StaticResource Currency}}"
                                   ToolTip="{Binding TotalExpensesMonth, Converter={StaticResource Currency}}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="23" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Money24" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="Gastos totales" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalExpensesAll, Converter={StaticResource Currency}}"
                                   ToolTip="{Binding TotalExpensesAll, Converter={StaticResource Currency}}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="23" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wallet24" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="Ingresos del mes" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalIncomeMonth, Converter={StaticResource Currency}}"
                                   ToolTip="{Binding TotalIncomeMonth, Converter={StaticResource Currency}}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="23" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataPie24" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="Cantidad de gastos" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding ExpenseCount}" ToolTip="{Binding ExpenseCount}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="23" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Torta + Balances -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Torta por categoría -->
                <ui:Card Grid.Column="0" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                            <TextBlock Text="Gastos por categoría" Style="{StaticResource SectionTitle}" />
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="9" Padding="8,2,8,2" Margin="10,0,0,10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PieScopeLabel}" FontSize="11" Opacity="0.8" />
                            </Border>
                        </StackPanel>
                        <!-- Leyenda y tooltip pintados según el tema (U6) -->
                        <lvc:PieChart Grid.Row="1" Series="{Binding CategorySeries}"
                                      LegendPosition="Right" MinHeight="300"
                                      LegendTextPaint="{Binding ChartTextPaint}"
                                      LegendBackgroundPaint="{Binding ChartSurfacePaint}"
                                      TooltipTextPaint="{Binding ChartTextPaint}"
                                      TooltipBackgroundPaint="{Binding ChartSurfacePaint}"
                                      Visibility="{Binding HasCategoryData, Converter={StaticResource BoolToVisible}}" />
                        <TextBlock Grid.Row="1" Text="Sin gastos para mostrar"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                                   Visibility="{Binding HasCategoryData, Converter={StaticResource InverseBoolToVisible}}" />
                    </Grid>
                </ui:Card>

                <!-- Balances + liquidación -->
                <ui:Card Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Balance entre personas" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Balances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6"
                                                VerticalAlignment="Center"
                                                Background="{Binding ColorHex, Converter={StaticResource HexBrush}}" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock FontSize="11" Opacity="0.6">
                                                <Run Text="Pagó" />
                                                <Run Text="{Binding Paid, Converter={StaticResource Currency}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold"
                                                   Text="{Binding Balance, Converter={StaticResource SignedCurrency}}"
                                                   Foreground="{Binding Balance, Converter={StaticResource BalanceBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,12" />

                        <TextBlock Text="Liquidación sugerida" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Settlement}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding FromName}" FontWeight="SemiBold" />
                                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" Margin="6,0" Opacity="0.6" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ToName}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontWeight="Bold"
                                                   Text="{Binding Amount, Converter={StaticResource Currency}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasSettlement, Converter={StaticResource InverseBoolToVisible}}">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="¡Las cuentas están saldadas!" Margin="8,0,0,0" Opacity="0.8" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Evolución mensual -->
            <ui:Card Grid.Row="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Gastos de los últimos 6 meses" Style="{StaticResource SectionTitle}" />
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding MonthlySeries}"
                                        XAxes="{Binding MonthlyXAxes}"
                                        YAxes="{Binding MonthlyYAxes}"
                                        LegendTextPaint="{Binding ChartTextPaint}"
                                        LegendBackgroundPaint="{Binding ChartSurfacePaint}"
                                        TooltipTextPaint="{Binding ChartTextPaint}"
                                        TooltipBackgroundPaint="{Binding ChartSurfacePaint}"
                                        TooltipPosition="Top"
                                        ZoomMode="None"
                                        MinHeight="260" />
                </Grid>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>

<Page x:Class="GastosCompartidos.Views.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:GastosCompartidos.Helpers"
      Title="Reportes">

    <ScrollViewer helpers:ScrollViewerHelper.FixMouseWheel="True"
                  helpers:ScrollViewerHelper.BindHeightToHost="True"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource PagePadding}" MaxWidth="760" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Reportes" Style="{StaticResource PageTitle}" />
                    <!-- Indicador de carga (B14) -->
                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                     Margin="12,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
                <TextBlock Text="Exportá un informe detallado en Excel del período que elijas" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <!-- Período -->
            <ui:Card Grid.Row="1" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Período" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button Content="Este mes" Margin="0,0,8,0" Command="{Binding PresetCommand}" CommandParameter="month" />
                        <ui:Button Content="Mes pasado" Margin="0,0,8,0" Command="{Binding PresetCommand}" CommandParameter="lastmonth" />
                        <ui:Button Content="Este año" Margin="0,0,8,0" Command="{Binding PresetCommand}" CommandParameter="year" />
                        <ui:Button Content="Todo" Command="{Binding PresetCommand}" CommandParameter="all" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Desde" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                            <!-- SelectedDateFormat="Short" (U12): el formato largo no entra en 150 px -->
                            <DatePicker Width="150" SelectedDateFormat="Short" SelectedDate="{Binding From}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Hasta" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                            <DatePicker Width="150" SelectedDateFormat="Short" SelectedDate="{Binding To}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                            <TextBlock Text="Seleccionado" FontSize="12" Opacity="0.7" />
                            <TextBlock Text="{Binding PeriodLabel}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Vista previa -->
            <ui:Card Grid.Row="2" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Vista previa del período" Style="{StaticResource SectionTitle}" />
                    <UniformGrid Rows="1" Columns="4">
                        <StackPanel>
                            <TextBlock Text="Gastos" FontSize="12" Opacity="0.6" />
                            <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource Currency}}"
                                       FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ingresos" FontSize="12" Opacity="0.6" />
                            <TextBlock Text="{Binding TotalIncome, Converter={StaticResource Currency}}"
                                       FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="N° de gastos" FontSize="12" Opacity="0.6" />
                            <TextBlock Text="{Binding ExpenseCount}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="N° de ingresos" FontSize="12" Opacity="0.6" />
                            <TextBlock Text="{Binding IncomeCount}" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </ui:Card>

            <!-- Exportar -->
            <ui:Card Grid.Row="3">
                <StackPanel>
                    <TextBlock Text="El archivo de Excel incluye:" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Margin="2,0,0,14">
                        <TextBlock Text="•  Resumen: balances por persona y liquidación sugerida" Opacity="0.8" Margin="0,2" />
                        <TextBlock Text="•  Gastos: detalle con la parte que le tocó a cada persona" Opacity="0.8" Margin="0,2" />
                        <TextBlock Text="•  Por categoría: totales y porcentajes" Opacity="0.8" Margin="0,2" />
                        <TextBlock Text="•  Ingresos: detalle de ingresos del período" Opacity="0.8" Margin="0,2" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Content="Exportar a Excel"
                                   Command="{Binding ExportCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DocumentArrowDown24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:ProgressRing IsIndeterminate="True" Width="26" Height="26" Margin="14,0,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>

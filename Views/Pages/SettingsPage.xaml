<Page x:Class="GastosCompartidos.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:GastosCompartidos.Helpers"
      Title="Configuración">

    <ScrollViewer helpers:ScrollViewerHelper.FixMouseWheel="True"
                  helpers:ScrollViewerHelper.BindHeightToHost="True"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="780" HorizontalAlignment="Left">

            <TextBlock Text="Configuración" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Personalizá la moneda, el tema y el comportamiento de la app" Style="{StaticResource PageSubtitle}" />

            <!-- Apariencia -->
            <ui:Card Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Apariencia" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Tema de la aplicación" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox Width="280" HorizontalAlignment="Left"
                              ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ThemeName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </ui:Card>

            <!-- Moneda -->
            <ui:Card Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Moneda y formato" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Símbolo de moneda" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
                            <!-- LostFocus (B8): con PropertyChanged cada tecla guardaba en la base
                                 y disparaba un refresco global de formato. -->
                            <ui:TextBox Width="120" MaxLength="4"
                                        Text="{Binding CurrencySymbol, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Decimales" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox Width="100" ItemsSource="{Binding DecimalOptions}" SelectedItem="{Binding Decimals}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Los importes usan el separador de miles y decimales de tu Windows."
                               Opacity="0.55" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- Gastos -->
            <ui:Card Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Gastos" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Tipo de división por defecto al crear un gasto" Opacity="0.7" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox Width="280" HorizontalAlignment="Left"
                              ItemsSource="{Binding SplitOptions}" SelectedItem="{Binding DefaultSplitType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource SplitTypeName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </ui:Card>

            <!-- Tipos de ingreso -->
            <ui:Card Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Tipos de ingreso" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:TextBox Width="240" PlaceholderText="Nuevo tipo (ej. Bonus)"
                                    Text="{Binding NewIncomeTypeName, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,8,0" />
                        <ui:Button Content="Agregar" Appearance="Secondary" Command="{Binding AddIncomeTypeCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding IncomeTypes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="10,5" CornerRadius="14"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <ui:Button Padding="3" Margin="8,0,0,0" Appearance="Transparent"
                                                   ToolTip="Eliminar tipo"
                                                   Command="{Binding DataContext.DeleteIncomeTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Datos -->
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="Datos" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Tus datos se guardan localmente en:" Opacity="0.7" FontSize="12" />
                    <TextBlock Text="{Binding DataFolderPath}" FontFamily="Consolas" FontSize="12" Margin="0,2,0,10"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Abrir carpeta de datos" Appearance="Secondary" Margin="0,0,8,0"
                                   Command="{Binding OpenDataFolderCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Borrar todos los datos" Appearance="Danger"
                                   Command="{Binding ResetDataCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
